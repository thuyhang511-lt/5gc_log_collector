# ---- Build stage ----
FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
COPY protocol ./protocol
COPY client ./client
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/client ./client

# ---- Runtime stage ----
FROM alpine:3.20
RUN adduser -D -H appuser
WORKDIR /app
COPY --from=builder /out/client .
USER appuser
ENTRYPOINT ["./client"]