# ---- Build stage ----
FROM golang:1.23-alpine AS builder
WORKDIR /src
COPY go.mod ./
COPY protocol ./protocol
COPY server ./server
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/server ./server

# ---- Runtime stage ----
FROM alpine:3.20
RUN adduser -D -H appuser
WORKDIR /app
COPY --from=builder /out/server .
USER appuser
EXPOSE 9000 8080
ENTRYPOINT ["./server"]